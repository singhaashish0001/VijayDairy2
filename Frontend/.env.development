# ------------------------------------------------------------------------------
# @file        .env.development
# @description Environment variables loaded by Vite exclusively in development
#              mode (i.e. when running `vite dev` or `npm run dev`).
#
#              All variables MUST be prefixed with VITE_ to be exposed to
#              client-side code via import.meta.env. Variables without this
#              prefix are intentionally kept server-side only and will NOT be
#              accessible in the browser bundle.
#
#              This file is NOT meant to hold real secrets — any sensitive
#              values belong in .env.local, which is git-ignored. This file
#              may be committed safely.
#
#              Main motive:
#                Centralise environment-specific configuration for local
#                development so the API base URL and asset base path can be
#                changed in one place without modifying source code.
# ------------------------------------------------------------------------------

# Base public path Vite serves assets from. Left empty in development so the
# dev server serves everything from the root path (/).
VITE_PUBLIC_URL=

# Backend REST API base URL used by core/service/base-service.ts (via the
# Axios instance in core/interceptor/interceptor.ts) for every HTTP call.
# Route paths in constants/url-constants.ts (e.g. '/auth/login') assume this
# base URL already ends in /api — do not omit the /api suffix.
# Leave empty instead to route through the Vite dev-server proxy (see
# vite.config.ts), which forwards /api to the backend without needing this set.
VITE_API_URL=http://localhost:5227/api

# Feature flag: when true, values written via secureStorage
# (src/helpers/secure-storage.ts) are XOR-obfuscated before being written to
# localStorage. Set to false in development to inspect localStorage values
# directly while debugging.
VITE_SECURE_STORAGE_ACTIVE=false
