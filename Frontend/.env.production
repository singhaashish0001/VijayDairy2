# ------------------------------------------------------------------------------
# @file        .env.production
# @description Environment variables loaded by Vite exclusively in production
#              mode (i.e. when running `vite build`).
#
#              All variables MUST be prefixed with VITE_ to be statically
#              inlined into the client bundle via import.meta.env at build
#              time. Variables without this prefix are intentionally kept
#              server-side only and will NOT be accessible in the browser
#              bundle.
#
#              IMPORTANT: Values in this file are baked into the compiled
#              JavaScript bundle at build time — do NOT store secrets here.
#
#              This file MUST be reviewed and updated to point at the correct
#              production API endpoint before every release build.
#
#              Main motive:
#                Centralise production-specific configuration so the API base
#                URL and asset base path can be switched from development to
#                production values in a single file without modifying source
#                code.
# ------------------------------------------------------------------------------

# Base public path the production build's assets are served from. Leave
# empty to serve from the root of the domain, or set to a sub-path
# (e.g. /vijay-dairy/) if the app is not hosted at the domain root.
VITE_PUBLIC_URL=

# Backend REST API base URL used by core/service/base-service.ts for every
# HTTP call in production. Must point at the live production API — there is
# no dev-server proxy in a production build, so this cannot be left empty.
VITE_API_URL=https://api.vijaydairy.example.com/api

# Feature flag: when true, values written via secureStorage
# (src/helpers/secure-storage.ts) are XOR-obfuscated before being written to
# localStorage. Always true in production to avoid storing the JWT/session
# data as plain readable JSON at rest.
VITE_SECURE_STORAGE_ACTIVE=true
